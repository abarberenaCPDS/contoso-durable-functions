{
  "IsEncrypted": false,
  "Values": {
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",
    "FUNCTIONS_INPROC_NET8_ENABLED": "1",
    "FUNCTIONS_WORKER_RUNTIME": "dotnet",
    "FUNCTIONS_WORKER_RUNTIME_VERSION": "v4",
    "APPINSIGHTS_INSTRUMENTATIONKEY": "",
    "ServiceBus:ConnectionString": "Endpoint=sb://localhost;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;",
    "ServiceBusQueueName": "queue.1"
  },
  "Logging": {
    "UseAppInsights": true,
    "UseDatadog": true,
    "UseConsoleColors": true,
    "TelemetryExporter": "DataDog",
    "EnableConsoleExporter": false,
    "DataDog": {
      "Endpoint": "https://otel.us5.datadoghq.com",
      "ApiKey": "<API-KEY>"
    }
  }
}